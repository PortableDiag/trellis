[Unit]
Description=Trellis snip watcher — import screenshots into Trellis
After=graphical-session.target

[Service]
# Runs the installed copy (on the home volume, so it survives the veracrypt
# volume being unmounted). Reinstall with install.sh after editing the script.
ExecStart=/usr/bin/python3 %h/.local/share/trellis-snip/snip-watcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
